# Braivanta customer-demand validation site — server-side environment variables.
# Never commit real values. Neither variable is ever sent to browser JavaScript.

# PostgreSQL connection string for the validation database (Neon-compatible).
# Apply db/schema.sql to this database before accepting submissions.
DATABASE_URL=

# Team token for the evidence dashboard and CSV export (sent as "Authorization: Bearer <token>").
# Use a long random value. If blank, admin access is refused.
BRAIVANTA_VALIDATION_ADMIN_TOKEN=
